# Copy to `.env` (gitignored) and fill in your key. run_sweep.py loads this file
# and injects the values into the experiment client. Shell environment variables,
# if already set, take precedence over this file.

# Anthropic API key for the synthetic ground (Option 1: provider per ground).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown; uncomment to change):
# MODEL_PROVIDER=anthropic
# WESLEY_EXPERIMENT_MODEL_ID=claude-haiku-4-5-20251001
# WESLEY_EXPERIMENT_TEMPERATURE=0
# WESLEY_EXPERIMENT_MAX_ROUNDS=20

# For the Wesley ground (Bedrock) instead, set:
# MODEL_PROVIDER=bedrock
# AWS_BEDROCK_ID=...
# AWS_BEDROCK_SECRET=...
# AWS_BEDROCK_REGION=eu-central-1
# WESLEY_EXPERIMENT_MODEL_ID=arn:aws:bedrock:...:application-inference-profile/...
